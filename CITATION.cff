    affiliation: "School of Photovoltaic and Renewable Energy Engineering, UNSW"
  - family-names: Yildiz
    given-names: Baran
    affiliation: "School of Photovoltaic and Renewable Energy Engineering, UNSW"
license: MIT
repository-code: "https://github.com/mssamhan31/PyNMDF"
